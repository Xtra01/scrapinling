# ============================================================
# LinkedIn Profile Scraper - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your API keys.
# NEVER commit your .env file to version control!
#
# NOTE: Proxycurl kapandı (July 2025, LinkedIn davası sonucu).
# Aşağıdaki API'ler aktif ve çalışır durumdadır.
# ============================================================

# ─── BRIGHT DATA (en yasal, en zengin veri, ~$750 for 15k) ───
# Site: https://brightdata.com
# Fiyat: ~$0.05/profil = ~$750 for 15k (pahalı ama en güvenli)
# Kazandığı davalar: Meta v. Bright Data (2024) + X Corp v. Bright Data (2024)
# Batch mode: 500 URL/batch, dakikalar-saatler arası sürebilir (SLA yok)
# ~%80 başarı oranı — ~3k profil retry gerekebilir
# En zengin veri: experience, educations_details, certifications,
#   recommendations (tam metin), publications, patents, projects, honors
# Dataset ID: gd_l1viktl72bvl7bjuj0 (LinkedIn People Profiles)
BRIGHTDATA_API_TOKEN=your_brightdata_api_token_here

# ─── PRIMARY: Scrapingdog ────────────────────────
# Site: https://www.scrapingdog.com
# Fiyat: Pro plan $200/mo = 3M kredi → 60,000 profil
#         (15k profil = 750k kredi = ~$50-135 pay-as-you-go)
# Rate limit: Plan bazlı, dahili limit yok
SCRAPINGDOG_API_KEY=your_scrapingdog_api_key_here

# ─── FALLBACK #1: Netrows ──────────────────────
# Site: https://www.netrows.com
# Fiyat: Growth €299/mo = 100k kredi (€0.005/istek)
#         15k profil = €75
# 48+ LinkedIn endpoint, real-time veri
NETROWS_API_KEY=your_netrows_api_key_here

# ─── FALLBACK #2: LinkdAPI ────────────────────
# Site: https://linkdapi.com
# Proxycurl'ün resmi alternatifi (explicit migration guide)
# Fiyat: Kredi bazlı, 100 ücretsiz deneme kredisi
# Python SDK: pip install linkdapi
# Sıfır fake hesap riski - LinkedIn mobile API kullanır
LINKDAPI_API_KEY=your_linkdapi_api_key_here

# ─── FALLBACK #3: People Data Labs ───────────────
# Site: https://www.peopledatalabs.com
# Fiyat: ~$0.04/kayıt; 15k ≈ ~$600 (enterprise: daha ucuz)
# En derin iş geçmişi verisi; Python SDK mevcut
PDL_API_KEY=your_pdl_api_key_here

# ─── FALLBACK #4: ScrapIn ────────────────────
# Site: https://scrapin.io
# Fiyat: Builders ~$1,000/mo | Production ~$2,500/mo
# Real-time LinkedIn verisi
SCRAPIN_API_KEY=your_scrapin_api_key_here

# ─── FALLBACK #5: RocketReach ───────────────
# Site: https://rocketreach.co/api
# Fiyat: $53/mo ve üzeri
ROCKETREACH_API_KEY=your_rocketreach_api_key_here

# ─── Scraper Ayarları ──────────────────────
# Eş zamanlı istek sayısı (API rate limitine göre ayarla)
MAX_CONCURRENCY=5

# İstekler arası gecikme (saniye)
REQUEST_DELAY=0.2

# Çıktı dizini
OUTPUT_DIR=data/output

# SQLite veritabanı yolu (checkpoint için)
DB_PATH=data/linkedin_profiles.db

# Log seviyesi: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
